// mooncassette CLI。
//
// 只承担「读文件 + 调库 + 打印」三件事，不含任何业务逻辑：
// 所有解析、校验与漂移比较都复用库内实现，确保 CLI 与库的行为不会分叉。
import {
  "moonbitlang/core/env",
  "moonbitlang/x/fs",
  "moonbitlang/x/sys",
  "weopqrst/mooncassette/codec",
  "weopqrst/mooncassette/core",
  "weopqrst/mooncassette/drift",
}

pkgtype(kind: "executable")
