name = "weopqrst/mooncassette"

version = "0.9.0"

readme = "README.mbt.md"

repository = "https://github.com/mihujiang/mooncassette.git"

license = "Apache-2.0"

keywords = [
  "llm",
  "testing",
  "record-replay",
  "cassette",
  "vcr",
  "deterministic",
  "mock",
  "regression-testing",
]

preferred_target = "wasm-gc"

description = "Deterministic record-and-replay (cassette) for LLM interactions: write offline, reproducible, drift-detecting regression tests for LLM applications without API keys or network."

import {
  "moonbitlang/x@0.5.5",
}
