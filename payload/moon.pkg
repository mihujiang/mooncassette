// mooncassette/payload —— 二进制载荷的编解码、归一与展示折叠。
//
// 设计要点：
// 1. 纯计算包：不依赖任何 IO / 网络 / 平台能力，全后端可编译可测试；
// 2. 刻意不使用标准库的 base64 实现 —— 与 @canon 自研规范写出器同理：
//    「什么算规范形式」必须由本项目自己定义，否则规范会随标准库的实现漂移，
//    而规范一旦漂移，历史 cassette 的指纹与完整性摘要就全部失效；
// 3. 解码端宽容（URL-safe 字母表 / 省略填充 / 忽略空白），写出端严格
//    （标准字母表 + 补齐填充 + 不含空白），从而保证
//    「同一份字节 → 同一段规范文本 → 同一个指纹」。
import {
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonbitlang/core/json",
} for "test"
